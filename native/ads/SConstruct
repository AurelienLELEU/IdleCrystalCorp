#!/usr/bin/env python
"""Build SCons de l'extension IdleAds.

Invoqué par `build.sh`, qui fournit l'environnement (ARCH, SDKROOT, ...) :
ce fichier ne fait que déclarer quoi compiler avec quoi.

Pourquoi un SConstruct alors que SCons peut se passer de lui : parce que les
fichiers Objective-C++ (.mm) ne sont pas reconnus par la détection
automatique de SCons, qui ne verrait que les .cpp et produirait une extension
sans le moindre appel à AdMob — qui compiles, mais plantent au premier clic.
"""

import os

# L'API GDExtension doit correspondre EXACTEMENT au moteur. build.sh la lit
# dans project.godot et l'exporte, donc il n'y a qu'une seule source de vérité.
# Un « 4.6 » oublié ici produirait une extension qui compile sans une seule
# erreur et qui est refusée au chargement, après toute la chaîne d'export et de
# signature : le pire moment pour l'apprendre.
GODOT_API_VERSION = os.environ.get("GODOT_API_VERSION", "")
if not GODOT_API_VERSION:
    print("!! GODOT_API_VERSION absent. Passez par build.sh : il la lit dans")
    print("   project.godot, et c'est la seule façon de ne pas se tromper de version.")
    Exit(1)

env = SConscript("godot-cpp/SConstruct", {"api_version": GODOT_API_VERSION})

env.Append(CPPPATH=["src/", "ios/"])

# Les .mm sont Objective-C++ : Objective-C++ ET C++.
env.Append(OBJSUFFIX=".mm.o")
env.Append(SUFFIX=[".mm", ".mm.o"])

# GoogleMobileAds.framework est un cadre dynamique : il doit être lié, et son
# chemin de recherche transmis au compilateur.
if env["platform"] == "ios":
    framework_dir = env.get("google_mobile_ads_path", "")
    # Foundation et UIKit sont requis même SANS le SDK AdMob : les delegates
    # Objective-C et l'interface iOS en dépendent. Ne les conditionner pas à la
    # présence d'AdMob, sinon la compilation « sans SDK » échoue pour une
    # raison qui n'a rien à voir avec le test que l'on voulait faire.
    env.Append(FRAMEWORKS=["Foundation", "UIKit", "AVFoundation", "CoreGraphics", "AdSupport"])
    # -fobjc-arc : sans lui, chaque alloc/init dans les delegates Objective-C
    # fuit, et AdMob appelle ses delegates assez souvent pour que ça se voie.
    env.Append(CCFLAGS=["-fobjc-arc"])
    if framework_dir and os.path.isdir(framework_dir):
        env.Append(LINKFLAGS=["-F", framework_dir, "-framework", "GoogleMobileAds"])
    else:
        # Le .mm garde ses #ifndef IDLE_ADS_NO_SDK. Il faut donc DÉFINIR le
        # symbole ici : sans cela le garde-fou ne protège rien et l'import de
        # GoogleMobileAds.h échoue quand même. C'est exactement ce que rendait
        # impossible la première compilation.
        env.Append(CPPDEFINES=["IDLE_ADS_NO_SDK"])
        print("!! GoogleMobileAds.framework introuvable — compilation sans le SDK AdMob.")
        print("   Les stubs laissent AdService.gd utiliser son simulateur, ce qui")
        print("   permet de valider tout le reste du jeu.")

sources = Glob("src/*.cpp") + Glob("ios/*.mm")
library = env.SharedLibrary(
    # `bin/` et NON `../bin/`. Le SConstruct est évalué depuis native/<nom>/, donc
    # « ../bin/ » produisait res://native/bin/, alors que le manifeste
    # .gdextension — seul fichier que Godot lit — annonce
    # res://native/<nom>/bin/. Les deux jamais lus ensemble : les binaires
    # étaient produits, le manifeste activé, et l'extension introuvable au
    # chargement. C'est le genre d'incohérence qu'aucun test ne voit tant que
    # personne n'essaie de charger l'extension pour de vrai.
    "bin/libidle_ads{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)
Default(library)
