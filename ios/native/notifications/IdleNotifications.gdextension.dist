; Manifeste de la GDExtension de rappels locaux IdleNotifications.
; build.sh le copie en .gdextension uniquement après un build complet.

[configuration]

entry_symbol = "idle_notifications_library_init"
compatibility_minimum = "4.2"
reloadable = true

[libraries]

macos.debug = "res://native/notifications/bin/libidle_notifications.macos.template_debug.universal.dylib"
macos.release = "res://native/notifications/bin/libidle_notifications.macos.template_release.universal.dylib"
ios.debug.arm64 = "res://native/notifications/bin/libidle_notifications.ios.template_debug.arm64.dylib"
ios.release.arm64 = "res://native/notifications/bin/libidle_notifications.ios.template_release.arm64.dylib"
ios.debug.arm64-simulator = "res://native/notifications/bin/libidle_notifications.ios.template_debug.universal.simulator.dylib"
ios.release.arm64-simulator = "res://native/notifications/bin/libidle_notifications.ios.template_release.universal.simulator.dylib"
ios.debug.x86_64-simulator = "res://native/notifications/bin/libidle_notifications.ios.template_debug.universal.simulator.dylib"
ios.release.x86_64-simulator = "res://native/notifications/bin/libidle_notifications.ios.template_release.universal.simulator.dylib"
