; Manifeste de la GDExtension « IdleStore ».
;
; POURQUOI L'EXTENSION EST EN « .dist » ET NON « .gdextension »
;
; Godot charge TOUTES les .gdextension présentes dans le projet. Tant que le
; binaire n'est pas compilé, il spamme quatre lignes d'erreur de dlopen à
; chaque lancement, dans l'éditeur comme dans les tests — et un projet qui hurle
; au démarrage masque les vrais problèmes.
;
; Le fichier s'appelle donc « .gdextension.dist ». `build.sh` le copie en
; « .gdextension » après une compilation réussie, et le supprime si le build
; échoue. Après un build réussi, il n'y a rien d'autre à configurer.
;
; Ne le renommez pas à la main pour « essayer » : vous revient aux erreurs de
; dlopen, et le fichier risque d'être committé par erreur.

[configuration]

entry_symbol = "idle_store_library_init"
compatibility_minimum = "4.2"
reloadable = true

[libraries]

; Ces noms ne sont pas choisis : ils sont produits par la règle de suffixe de
; godot-cpp, « .<plateforme>.<cible>.<arch>[.simulator] », plus l'extension de
; la bibliothèque. Écrire ces chemins à la main avait produit des entrées sans
; fichier correspondant : l'extension compilait, le manifeste s'activait, et
; Godot ne trouvait toujours pas la bibliothèque au chargement.
;
; Le simulateur est un binaire « universal » (x86_64 + arm64) : les deux
; étiquettes de simulateur pointent sur le MÊME fichier, qui contient les deux
; tranches. Le fichier existe donc que Godot demande arm64-simulator ou
; x86_64-simulator.
;
; tests/check_native_contract.py vérifie que chaque chemin existe sur le disque
; dès qu'une extension a été compilée.
macos.debug = "res://native/store/bin/libidle_store.macos.template_debug.universal.dylib"
macos.release = "res://native/store/bin/libidle_store.macos.template_release.universal.dylib"

ios.debug.arm64 = "res://native/store/bin/libidle_store.ios.template_debug.arm64.dylib"
ios.release.arm64 = "res://native/store/bin/libidle_store.ios.template_release.arm64.dylib"
ios.debug.arm64-simulator = "res://native/store/bin/libidle_store.ios.template_debug.universal.simulator.dylib"
ios.release.arm64-simulator = "res://native/store/bin/libidle_store.ios.template_release.universal.simulator.dylib"
ios.debug.x86_64-simulator = "res://native/store/bin/libidle_store.ios.template_debug.universal.simulator.dylib"
ios.release.x86_64-simulator = "res://native/store/bin/libidle_store.ios.template_release.universal.simulator.dylib"
